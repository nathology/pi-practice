[Unit]
Description=The Pi of Pi Voice Memorization Game
After=sound.target network.target

[Service]
Type=simple
User=noahfitz
WorkingDirectory=/home/noahfitz/repo/pi-practice
ExecStart=/home/noahfitz/voice_env/bin/python main.py

# Force systemd to loop restart the app regardless of clean or dirty exit codes
Restart=always
RestartSec=3

# Ensure python logs aren't cached internally
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target